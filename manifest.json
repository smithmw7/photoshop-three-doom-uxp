{
  "manifestVersion": 5,
  "id": "com.hightopgames.photoshop-three-doom-benchmark",
  "name": "Three Doom Benchmark",
  "version": "1.6.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "threeDoomBenchmarkPanel",
      "label": {
        "default": "Three Doom Benchmark"
      },
      "minimumSize": {
        "width": 720,
        "height": 760
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 960,
        "height": 780
      },
      "preferredFloatingSize": {
        "width": 1024,
        "height": 820
      }
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "webview": {
      "domains": [],
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    }
  }
}
